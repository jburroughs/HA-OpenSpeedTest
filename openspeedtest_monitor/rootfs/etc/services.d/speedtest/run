#!/usr/bin/env bash
# s6 services run in a clean environment — explicitly source container env
# so SUPERVISOR_TOKEN (injected by HA supervisor) is available.

with_env() {
    # Read environment from PID 1 (the container init process)
    # This gives us SUPERVISOR_TOKEN and other HA-injected vars
    if [ -f /proc/1/environ ]; then
        while IFS= read -r -d '' var; do
            export "$var" 2>/dev/null || true
        done < /proc/1/environ
    fi
}

with_env
exec /usr/bin/speedtest_runner.sh
